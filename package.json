{
  "name": "cinesco-cli",
  "version": "0.1.0",
  "description": "Buy movie tickets in Colombia from the terminal — Royal Films, Cine Colombia, Cinemark. Agent-first, up to the payment link (never charges).",
  "type": "module",
  "bin": {
    "cinesco": "dist/cinesco.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/presentation/cinesco.ts",
    "build": "bun scripts/build.ts",
    "build:binaries": "bash scripts/build-all.sh",
    "test": "bun test",
    "verify:dist": "bash scripts/verify-dist.sh",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "cine",
    "cinema",
    "tickets",
    "colombia",
    "cli",
    "agent",
    "royalfilms",
    "cinecolombia",
    "cinemark"
  ],
  "license": "MIT"
}
